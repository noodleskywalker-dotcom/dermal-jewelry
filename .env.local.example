# Copy this file to .env.local and fill in real values.
# .env.local is gitignored. Never commit real credentials.
# These are server-side values. Do not rename them to NEXT_PUBLIC_*.

# Shopify store domain, for example your-store.myshopify.com
SHOPIFY_STORE_DOMAIN=

# Storefront API access token from the Shopify Headless channel
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Storefront API version, for example the current stable version shown in Shopify docs
SHOPIFY_API_VERSION=

# ── Commission requests (/commission). See docs/COMMISSION.md. ──
# Private reference storage. Created by connecting a Vercel Blob store to the project, which sets it.
BLOB_READ_WRITE_TOKEN=

# Resend API key, used by the server only to email each request to the studio.
RESEND_API_KEY=

# Where requests are sent. Defaults to noodleskywalker@gmail.com when empty.
COMMISSION_TO_EMAIL=noodleskywalker@gmail.com

# Optional. The sender. Until a domain is verified in Resend, leave this empty: the default
# "DERMAL Commissions <onboarding@resend.dev>" can only deliver to the Resend account's own address.
COMMISSION_FROM_EMAIL=

# Optional. Secret for signing reference links. Derived from BLOB_READ_WRITE_TOKEN when empty.
COMMISSION_SIGNING_SECRET=
