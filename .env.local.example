# Copy this file to .env.local and fill in real values.
# .env.local is gitignored. Never commit real credentials.
# These are server-side values. Do not rename them to NEXT_PUBLIC_*.

# Shopify store domain, for example your-store.myshopify.com
SHOPIFY_STORE_DOMAIN=

# Storefront API access token from the Shopify Headless channel
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Storefront API version, for example the current stable version shown in Shopify docs
SHOPIFY_API_VERSION=
